APP_NAME="Smart System Investment"
APP_ENV=production
APP_KEY=base64:YOUR_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-railway-domain.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=your-db-host.proxy.rlwy.net
DB_PORT=your-db-port
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=your-password-here

TRUST_PROXY=*

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIES=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo (transactional email) — the app explicitly routes OTP, password
# reset, account status, and admin/bulk emails through this mailer
# regardless of MAIL_MAILER above (see AppServiceProvider::boot()).
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Gaming & Prediction — optional automatic fixture source (football-data.org).
# Free tier: https://www.football-data.org/client/register — no card needed.
# If left blank, manual fixture entry in Admin > Gaming & Prediction keeps
# working as the fallback; nothing else is affected.
FOOTBALL_DATA_API_KEY=

# Live Market — crypto pricing (CoinPaprika, free tier, keyless by default).
# Leave blank unless/until moving to a paid CoinPaprika plan.
MARKET_DATA_PROVIDER=coinpaprika
MARKET_DATA_BASE_URL=https://api.coinpaprika.com/v1
MARKET_DATA_API_KEY=
MARKET_DATA_CACHE_TTL=60

# Live Market — Commodities & Indices (Gold, S&P 500, NASDAQ). Get a free
# key at https://twelvedata.com/register (no card needed, 800 calls/day).
# Left blank, these three assets show a "not connected" state instead of
# a fake price — crypto keeps working either way.
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

VITE_APP_NAME="${APP_NAME}"

# Scheduled tasks (see config/scheduling.php). Maturity PAYS profit: dry-run first, then enable.
SCHEDULE_INVESTMENT_MATURITY=false
SCHEDULE_FIXTURE_SYNC=true

# Telegram webhook protection. Generate a long random string (16+ chars) and give the SAME value to Telegram via
# setWebhook (secret_token=...). Leave empty to keep the webhook disabled.
TELEGRAM_WEBHOOK_SECRET=

# Deposit -> Telegram. The deployment-wide representative used for investors WITHOUT an individually assigned agent
# (the pre-existing policy). There is NO built-in default: leave empty and those investors see a "details unavailable"
# message instead of a made-up contact. Individually assigned agents are set with `php artisan ssi:deposit-agent`.
TELEGRAM_AGENT_USERNAME=
TELEGRAM_AGENT_NAME=

# --- Remediation (Nov 2026) — financial controls; defaults are the safe values. See config/financial_controls.php and docs/MANAGEMENT_DECISIONS.md
FIN_DUAL_APPROVAL_ENABLED=true
FIN_APPROVAL_BALANCE_RESET=true
FIN_APPROVAL_BULK_BALANCE=true
FIN_APPROVAL_PROFIT_ADJUST=true
FIN_APPROVAL_THRESHOLD_USD=10000.00
FIN_BULK_MAX_ACCOUNTS=500
FIN_APPROVAL_INVESTMENT_CORRECTION=true
# R6: leave as legacy_float until Finance approves exact_decimal in writing
FINANCIAL_DEPOSIT_VALUATION_MODE=legacy_float
# Management decisions pending (safe defaults): profit approvers admin-only; cumulative limit empty = reuse the single threshold; expiry disabled; no profit cap
FIN_PROFIT_APPROVER_ROLES=admin
FIN_CUMULATIVE_WINDOW_HOURS=24
FIN_CUMULATIVE_THRESHOLD_USD=
FIN_APPROVAL_EXPIRY_HOURS=
FIN_STUCK_EXECUTION_MINUTES=15
FIN_PROFIT_PERCENTAGE_CAP=
# Deployment (docker-entrypoint.sh): run the one-shot role "migrate" with MIGRATE_CONFIRM=yes; optional web guard:
# SCHEMA_CHECK_MODE=warn   # warn (default: log + keep serving) | enforce (refuse to start on an unready schema) | off
PRIVACY_EMAIL_EXTERNAL_IMAGES=false

# ── Tasks 2-5 integration (names only; no secrets here — set real values in your private .env) ──
# Task 2 — Registration Team (tracking is OFF unless enabled; wording/consent notice awaits Management approval)
REGISTRATION_VISIT_TRACKING=false
REGISTRATION_NOTIFY_ON_VISIT=false
# REGISTRATION_RESUME_MAILER=        # mailer used for resume codes (defaults to the app mailer)
# REGISTRATION_RESUME_CODE_TTL_MINUTES= / REGISTRATION_RESUME_CODE_MAX_ATTEMPTS= / REGISTRATION_RESUME_REQUESTS_PER_HOUR= / REGISTRATION_RESUME_REQUEST_COOLDOWN_SEC=
# REGISTRATION_FOLLOWUP_COOLDOWN_HOURS= / REGISTRATION_FOLLOWUP_MAX= / REGISTRATION_INCOMPLETE_AFTER_HOURS=
# REGISTRATION_TRACKING_NOTICE_VERSION= / REGISTRATION_VISIT_RETENTION_DAYS= / REGISTRATION_VISIT_ALERT_MAX_PER_HOUR= / REGISTRATION_VISIT_MAX_NEW_PER_HOUR=
# Task 3 — Mailing
MAILING_MAILER=brevo
# MAILING_FROM_ADDRESS=              # must be a Brevo-verified sender; falls back to MAIL_FROM_ADDRESS
MAILING_FROM_NAME="Smart System Investment"
MAILING_WEBHOOK_SECRET=              # REQUIRED to enable provider webhooks; empty = webhooks disabled (401)
MAILING_CONSENT_POLICY_VERSION=2026-11
# MAILING_MAX_ATTEMPTS= / MAILING_CONTACT_PER_MINUTE= / MAILING_CONTACT_PER_DAY=
# Task 4 — News & Media
NEWS_MEDIA_DISK=local                # use a persistent/volume or S3-compatible PRIVATE disk on ephemeral hosts
# NEWS_MAX_IMAGE_KB= / NEWS_MAX_VIDEO_KB=
# Task 5: WITHDRAWAL_FEE_ADJUSTMENTS_ENABLED=false  (fee reverse/waive/refund stays OFF until Management approves the rules); policies themselves are set in the Financial dashboard and none is approved by default
# Gap-closure round
REGISTRATION_DISCLOSURE_LIMIT_PER_HOUR=20   # per-IP hourly budget for stage-1 responses that reveal account state (anti-enumeration mitigation)
# Registration enumeration closure (stage 1 answers every email identically; the account is created only after the emailed code)
REGISTRATION_STAGE1_ATTEMPTS_PER_HOUR=30    # per-IP cap on stage-1 requests (counts every request, reveals nothing)
REGISTRATION_VERIFY_ATTEMPTS_PER_HOUR=60    # per-IP cap on /register/verify requests
REGISTRATION_MIN_RESPONSE_MS=400            # response-time floor for stage 1 and verify (timing side channel); 0 disables
